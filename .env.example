# ─────────────────────────────────────────────────────────────────────────────
# Anime Watch Together — пример конфигурации.
# Скопируйте в .env и поправьте под себя: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Приложение ───────────────────────────────────────────────────────────────
APP_NAME=Anime Watch Together
# Внешний адрес сайта. Влияет на OAuth redirect_uri, ссылки на комнаты и на то,
# получит ли cookie флаг Secure.
BASE_URL=http://localhost:8000
DEBUG=false

# ОБЯЗАТЕЛЬНО задайте в проде: подписывает сессии и ссылки на видео.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Срок жизни сессии, сек (по умолчанию 14 дней)
SESSION_MAX_AGE=1209600

# ── Авторизация через Discord ────────────────────────────────────────────────
# Главный переключатель. false — гостевой режим: на входе просят только имя.
DISCORD_AUTH_ENABLED=false

# Вкладка OAuth2 в https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Если пусто — берётся BASE_URL + /auth/discord/callback.
# Этот же адрес должен быть добавлен в Redirects приложения Discord.
DISCORD_REDIRECT_URI=

# ID гильдии, членство в которой даёт доступ к сайту.
# Правый клик по серверу → Копировать ID сервера (нужен режим разработчика).
DISCORD_GUILD_ID=

# Как проверять членство:
#   oauth — от имени пользователя (ничего сверх OAuth-приложения не нужно)
#   bot   — ботом (нужен DISCORD_BOT_TOKEN, бот на сервере, intent Server Members)
#   off   — не проверять, пускать любой Discord-аккаунт
DISCORD_GUILD_CHECK=oauth
DISCORD_BOT_TOKEN=

# Пускать только обладателей этих ролей (ID через запятую). Пусто — все участники.
DISCORD_REQUIRED_ROLE_IDS=
# Администраторы сайта: могут закрывать любые комнаты.
DISCORD_ADMIN_IDS=

# ── Каталог аниме ────────────────────────────────────────────────────────────
# animego (по умолчанию) или animedia
CATALOG_SOURCE=animego
# Зеркало AnimeGO, если основной домен закрыт: например animego.me
ANIMEGO_MIRROR=
ANIMEDIA_BASE_URL=https://amd.online

# Прокси для запросов к источникам: http://host:port или socks5://host:port
# Для socks: pip install "anime-dl-core[socks]"
HTTP_PROXY=
HTTP_TIMEOUT=25

CATALOG_CACHE_TTL=600
# Прямые ссылки живут недолго — большим это значение делать нельзя
STREAM_CACHE_TTL=240
SEARCH_LIMIT=24

# ── Видео ────────────────────────────────────────────────────────────────────
# Проксировать поток через сервер. Почти всегда обязательно: CDN требует Referer
# и привязывает ссылку к IP, который её получил.
STREAM_PROXY_ENABLED=true
STREAM_TOKEN_TTL=21600
STREAM_MAX_QUALITY=1080

# ── Комнаты ──────────────────────────────────────────────────────────────────
ROOM_IDLE_TIMEOUT=10800
ROOM_MAX_MEMBERS=25
# everyone — плеером управляют все зрители, host — только владелец
ROOM_DEFAULT_CONTROL=everyone
ROOM_CHAT_HISTORY=100
ROOM_SYNC_INTERVAL=8
ROOM_SYNC_TOLERANCE=1.5

# ── Трекинг ──────────────────────────────────────────────────────────────────
TRACKING_ENABLED=true
EPISODE_COMPLETED_RATIO=0.85
PROGRESS_REPORT_INTERVAL=15

# Раздел «Пользователи»: чужие профили и списки аниме видны всем, кто вошёл.
PROFILES_ENABLED=true

# ── Уведомления о новых сериях ───────────────────────────────────────────────
# Бот пишет подписчикам, когда у отслеживаемого тайтла выходит новая серия.
# Нужен DISCORD_BOT_TOKEN (тот же, что и для DISCORD_GUILD_CHECK=bot) и бот
# на общем с людьми сервере — иначе личные сообщения не доставляются.
NOTIFICATIONS_ENABLED=false
# Как часто сверять список серий, сек. Меньше 60 не ставится.
NOTIFY_POLL_INTERVAL=1800
# ID канала, куда писать всем вместо личных сообщений. Пусто — каждому в ЛС.
# Персональный канал можно задать в разделе «Уведомления» на сайте.
NOTIFY_CHANNEL_ID=

# ── База данных ──────────────────────────────────────────────────────────────
# SQLite (по умолчанию, схема создаётся сама):
DATABASE_URL=sqlite+aiosqlite:///./data/anime_watch.db
# PostgreSQL (нужен профиль postgres в docker compose и alembic upgrade head):
# DATABASE_URL=postgresql+asyncpg://anime:anime@db:5432/anime
DB_ECHO=false

# Используется только docker compose с профилем postgres
POSTGRES_USER=anime
POSTGRES_PASSWORD=anime
POSTGRES_DB=anime
